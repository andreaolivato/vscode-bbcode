{
    "files.exclude": {
        "out": false,
        "dist": false
    },
    "search.exclude": {
        "out": true,
        "dist": true,
        ".vscode-test": true
    },
    "typescript.tsc.autoDetect": "off",
    "typescript.tsdk": "node_modules/typescript/lib",
    "editor.formatOnSave": false,
    "eslint.validate": ["typescript", "javascript"],
    "[typescript]": {
        "editor.tabSize": 4
    },
    "[json]": {
        "editor.tabSize": 2
    }
}
